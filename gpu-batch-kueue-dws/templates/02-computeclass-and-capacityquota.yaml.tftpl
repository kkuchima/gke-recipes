apiVersion: cloud.google.com/v1
kind: ComputeClass
metadata:
  name: gpu-batch-primary
spec:
  nodePoolAutoCreation:
    enabled: true
  nodePoolConfig:
    imageType: cos_containerd
  priorities:
%{ if specific_g4_reservation_name != "" ~}
  # Priority 1: Specific Capacity Reservation (+ リソースベース CUD) を最優先消化
  - machineType: ${g4_machine_type}
    spot: false
    gpu:
      type: nvidia-rtx-pro-6000
      count: 1
      driverVersion: latest
    storage:
      bootDiskType: hyperdisk-balanced
      bootDiskSize: 100
      localSSDCount: 4
    reservations:
      affinity: Specific
      specific:
      - name: ${specific_g4_reservation_name}
        zones:
        - ${g4_zone}
%{ else ~}
  # (参考) Specific Capacity Reservation を利用する場合は var.specific_g4_reservation_name を設定すると自動有効化されます
%{ endif ~}
  # Priority: On-Demand G4 (Compute Flexible CUD 対象 / 東京は ${g4_zone} 限定)
  - machineType: ${g4_machine_type}
    spot: false
    gpu:
      type: nvidia-rtx-pro-6000
      count: 1
      driverVersion: latest
    storage:
      bootDiskType: hyperdisk-balanced
      bootDiskSize: 100
      localSSDCount: 4
    location:
      zones:
      - ${g4_zone}

  # Priority: On-Demand L4 マルチゾーンフォールバック (※ G2 では localSSDCount を指定しないこと)
  - machineFamily: g2
    spot: false
    gpu:
      type: nvidia-l4
      count: 1
      driverVersion: latest
    storage:
      bootDiskType: pd-balanced
      bootDiskSize: 100
    location:
      zones:
%{ for z in l4_zones ~}
      - ${z}
%{ endfor ~}

  # Priority: バースト枠 DWS Flex-start G4 (ノード再利用可能)
  - machineType: ${g4_machine_type}
    flexStart:
      enabled: true
    maxRunDurationSeconds: 86400
    gpu:
      type: nvidia-rtx-pro-6000
      count: 1
      driverVersion: latest
    storage:
      bootDiskType: hyperdisk-balanced
      bootDiskSize: 100
      localSSDCount: 4
    location:
      zones:
      - ${g4_zone}
  whenUnsatisfiable: DoNotScaleUp
---
apiVersion: autoscaling.x-k8s.io/v1beta1
kind: CapacityQuota
metadata:
  name: gpu-batch-primary-cap
spec:
  selector:
    matchLabels:
      cloud.google.com/compute-class: gpu-batch-primary
  limits:
    resources:
      nvidia.com/gpu: 16
